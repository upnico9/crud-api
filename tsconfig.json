{
  "compilerOptions": {
    "target": "ES2021",                                  
    "module": "commonjs",                                
    "rootDir": "./src",                                  
    "sourceMap": true,                                
    "outDir": "./dist",                                
    "esModuleInterop": true,                             
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,            
    "strict": true,                                      
    "skipLibCheck": true                                 
  },
  "include": ["src/**/*"] 
}
